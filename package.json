{
  "name": "dsh-plugin-guard",
  "version": "0.1.0",
  "description": "Pre-installation security audit and approval gate middleware for DeepSeek Harness (DSH) plugins.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/Ronnoc/dsh-plugin-guard#readme",
  "bugs": {
    "url": "https://github.com/Ronnoc/dsh-plugin-guard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "ai-agent",
    "agent",
    "mcp",
    "model-context-protocol",
    "security",
    "security-audit",
    "audit",
    "supply-chain",
    "supply-chain-security",
    "sandbox"
  ],
  "author": "kybconnor",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ronnoc/dsh-plugin-guard.git"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  }
}
